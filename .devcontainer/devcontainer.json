{
  "name": "Taller agente CCDV-F",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Agente TiendaTech", "onAutoForward": "openPreview" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": { "description": "API key de Anthropic que te dio la instructora para el taller" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy"]
    }
  }
}
